    container.innerHTML = '';

    const fragment = document.createDocumentFragment();

    for (const item of board) {
        if (!item) continue;

        const itemDiv = document.createElement('div');
        itemDiv.className = 'board-post';

        const title = escapeHTML(item.title ?? '');

