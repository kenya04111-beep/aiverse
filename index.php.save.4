    function bind(el, type) {
        if (!el || el.dataset.bound === '1') return;

        el.addEventListener(type, handleChange, { passive: true });
        el.dataset.bound = '1';
    }

    function init() {

        if (initialized) return;

        const { title, body, category } = getEls();

        if (!title || !body || !category) return;

        bind(title, 'input');
        bind(body, 'input');
