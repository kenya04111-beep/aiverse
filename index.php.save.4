        ? window.AppState.playlists
        : [];
    const value = parseInt(selector.value, 10);

    if (Number.isNaN(value)) return;

if (
    value < 0 ||
    value >= window.AppState.playlists.length
) return;

window.AppState.activePlaylistIdx = value;
    try {
        saveToLocalStorage?.();
    } catch (e) {
        console.error("save failed:", e);
    }

    renderBgmTracks?.();
}
