    const isPublic = !!get('admin-public')?.checked;

    if (!titleVal || !bodyVal) {
        alert("タイトルと本文は必須です。");
        return;
    }

window.AppState.posts =
    Array.isArray(window.AppState.posts)
        ? window.AppState.posts
        : [];
    const idNum = idRaw ? Number(idRaw) : null;

    // ---- 更新 / 追加 ----
    if (Number.isFinite(idNum)) {
const post =
